STEP 4: Verify Fault Tolerance & Flaky Tool Auto-Retry
--------------------------------------------------------------------------------
# Submit a task with '__FLAKY_TEST__' to trigger transient network simulation
FLAKY_RES=$(curl -s -X POST http://localhost:8000/api/v1/tasks \
  -H "Content-Type: application/json" \
  -d '{"prompt": "__FLAKY_TEST__"}')

FLAKY_ID=$(echo "$FLAKY_RES" | grep -o '"task_id":"[^"]*' | cut -d'"' -f4)
echo "Flaky Task ID: $FLAKY_ID"

# Wait 2 seconds and inspect structured JSON activity log
sleep 2
tail -n 10 logs/agent_activity.log

# Expected Log Entries in logs/agent_activity.log:
# 1. Action details: "Tool execution failed on attempt 1: Simulated transient network timeout.. Retrying..."
# 2. Action details: "Tool execution succeeded on retry attempt 2."


