--------------------------------------------------------------------------------
STEP 1: Start All Services via Docker Compose
--------------------------------------------------------------------------------
# Build and start all 4 services in the background (API, Celery Worker, PostgreSQL, Redis)
docker compose up --build -d

# Verify all containers are running and healthy
docker compose ps


--------------------------------------------------------------------------------
STEP 2: Verify Service Health Check
--------------------------------------------------------------------------------
curl -s -X GET http://localhost:8000/health

# Expected Response:
# {"status":"healthy","database":"connected","redis":"connected"}


--------------------------------------------------------------------------------
STEP 3: Full Multi-Agent & Human-in-the-Loop (HITL) Workflow
--------------------------------------------------------------------------------

# 3A. Create a New Collaborative Agent Task
RESPONSE=$(curl -s -X POST http://localhost:8000/api/v1/tasks \
  -H "Content-Type: application/json" \
  -d '{"prompt": "Research the key features of LangGraph and CrewAI. Write a short comparison summary for a technical audience."}')

echo "Create Task Response: $RESPONSE"

# Extract task_id into a variable (or copy the UUID from the output manually)
TASK_ID=$(echo "$RESPONSE" | grep -o '"task_id":"[^"]*' | cut -d'"' -f4)
echo "Active Task ID: $TASK_ID"

# Expected Response (HTTP 202 in <500ms):
# {"task_id":"...","status":"PENDING"}


# 3B. Check Task Status While Paused for Human Approval
# Wait 2-3 seconds for ResearchAgent and WritingAgent to complete Phase 1
sleep 2
curl -s -X GET http://localhost:8000/api/v1/tasks/$TASK_ID

# Expected Response:
# status will be "AWAITING_APPROVAL", result contains draft summary, agent_logs contains 2 entries.


# 3C. Inspect the Redis Ephemeral Scratchpad Workspace
docker exec -it langgraph_redis redis-cli get "task:$TASK_ID:workspace"

# Expected Response:
# JSON containing raw research findings stored by ResearchAgent under task:<task_id>:workspace


# 3D. Provide Human Approval
curl -s -X POST http://localhost:8000/api/v1/tasks/$TASK_ID/approve \
  -H "Content-Type: application/json" \
  -d '{
    "approved": true,
    "feedback": "Looks great! Include deployment recommendations."
  }'

# Expected Response (HTTP 200):
# {"task_id":"...","status":"RESUMED"}


# 3E. Retrieve Final Completed Task
sleep 2
curl -s -X GET http://localhost:8000/api/v1/tasks/$TASK_ID

# Expected Response:
# status will be "COMPLETED", result contains final summary with feedback incorporated.


