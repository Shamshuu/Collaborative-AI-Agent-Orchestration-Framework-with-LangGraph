STEP 5: Test Real-Time WebSocket Streaming
--------------------------------------------------------------------------------
python3 -c "
import asyncio, json, httpx, websockets

async def stream_task():
    async with httpx.AsyncClient() as client:
        # Create task
        res = await client.post('http://localhost:8000/api/v1/tasks', json={'prompt': 'WebSocket live test'})
        task_id = res.json()['task_id']
        print(f'Listening to WebSocket for Task ID: {task_id}')

        # Connect to WebSocket
        async with websockets.connect(f'ws://localhost:8000/ws/tasks/{task_id}') as ws:
            while True:
                msg = await ws.recv()
                data = json.loads(msg)
                print(f'-> Live Status Update: {data[\"status\"]}')
                
                if data.get('status') == 'AWAITING_APPROVAL':
                    print('Sending approval...')
                    await client.post(f'http://localhost:8000/api/v1/tasks/{task_id}/approve', json={'approved': True})
                
                if data.get('status') in ['COMPLETED', 'FAILED']:
                    break

asyncio.run(stream_task())
"

